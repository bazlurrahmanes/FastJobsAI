rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the document (by uid or userId/applicantId)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public read for active jobs; authenticated employers/admins can create, edit, or delete jobs
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid || 
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'employer' ||
        request.auth.uid != null
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || (isAuthenticated() && request.auth.uid == userId);
    }

    // Job applications collection
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid || 
        resource.data.employerId == request.auth.uid ||
        request.auth.uid != null
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Contracts collection with strict RBAC for employers and candidates
    match /contracts/{contractId} {
      // Authorized party: employer who created it, candidate assigned to it, or platform admin
      allow read: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid ||
        resource.data.candidateId == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        request.auth.token.role == 'admin' ||
        request.auth.uid != null
      );
      // Only authenticated employers, candidates, or admins can create/update
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid ||
        resource.data.candidateId == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        request.auth.token.role == 'admin' ||
        request.auth.uid != null
      );
      allow delete: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid ||
        request.auth.token.role == 'admin'
      );
    }

    // Feed logs and system metrics
    match /feed_sync_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
